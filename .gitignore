__pycache__/
*.pyc

# Everything that is not ours to publish lives under private/: third-party binaries and installers, what
# was derived from them, the notes on how they were read, and the scripts that read them. One directory,
# ignored as a whole, so nothing in it is one `git add -A` away from the remote. Root-level archives are
# ignored as a class as well, since vendor drops land there before they are moved.
private/
CLAUDE.local.md
/*.zip
/*.exe
.venv/
sessions/

# Generated by tests/conftest.py on first run, deterministic from the code that writes it.
tests/fixtures/

# rendered screens, for looking at rather than for keeping
shots/
